# The local working database. It carries whatever has been typed into the app,
# and a fresh clone is meant to run `php artisan migrate` rather than inherit it.
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-wal
/database/*.sqlite-shm

# AppleDouble sidecars, which macOS scatters over the non-HFS volume this lives on.
._*
.Spotlight-V100
.Trashes
